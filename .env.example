# ==========================================
# Docker Configuration
# ==========================================
# User ID and Group ID mapping for file permissions on Linux
# Run `id -u` and `id -g` to find your values.
HOST_UID=1000
HOST_GID=1000

# Single SSH private key mounted read-only into the container for git over SSH.
# Only this one key is exposed to the agent (not the whole ~/.ssh directory).
# Generate a dedicated key with: make ssh-key
# Leave unset to default to $HOME/.ssh/pi_agent_ed25519.
# SSH_KEY=/home/youruser/.ssh/pi_agent_ed25519

# Run multiple isolated instances at once (optional).
# Set a unique PROJECT_NAME per instance; PI_DATA_DIR then defaults to
# .pi-data-<PROJECT_NAME> so each instance keeps its own sessions/settings.
# PROJECT_NAME=agent1
# PI_DATA_DIR=.pi-data-agent1

# Run the container detached (background) instead of the default foreground
# mode (optional). Set to true or 1 to detach.
# DETACHED=true


# GitHub API token for the gh CLI (OPTIONAL).
# Only needed if you want the agent to use gh for GitHub API operations
# (issues, PRs, releases, gh api, etc.). Git transport uses SSH and does
# not need this. Leave unset/comment out for a git-only agent.
# GITHUB_TOKEN=git_token

# Git identity
GIT_NAME=git_user
GIT_EMAIL=git_email

# Commit Signing
GIT_GPG_KEY=id
GIT_GPG_SIGN=false

# Managed skills/extensions repo (optional)
# Point to a git repo containing a pi-package with skills/ and extensions/ directories.
# These will be cloned into .pi-data/agent/ at build time by the Makefile.
# Uncomment and set the URL to enable:
# MANAGED_REPO_URL=https://github.com/your-org/pi-skills-extensions
# MANAGED_REPO_REF=main

# LLM Wiki (opt-in, shared KB)
# Enabled per session only, with `pictl -w` or `make run WIKI=true`. When
# enabled, the shared vault is mounted and @zosmaai/pi-llm-wiki is loaded for
# that run. Plain runs are unaffected.
#   LLM_WIKI_DIR      host dir whose .llm-wiki/ subdir is the shared vault
#                     (default: $HOME/pi-llm-wiki)
#   LLM_WIKI_VERSION  pinned @zosmaai/pi-llm-wiki version (default: 0.12.2)
# LLM_WIKI_DIR=/home/you/pi-llm-wiki
# LLM_WIKI_VERSION=0.12.2


# Docker network subnet for this instance (optional).
# Each project gets its own bridge network. Docker's default allocator hands
# out a whole /16 per network from a pool of only ~15, so a dozen projects
# exhaust it with "all predefined address pools have been fully subnetted".
# The Makefile/pictl instead give every project a /24 from PI_NETWORK_BASE.
#
#   PI_NETWORK_BASE       block the per-project /24s are allocated from,
#                         anything /8../16 (default: 10.200.0.0/13). Pick a
#                         block that does not overlap your LAN/VPN.
#   PI_NETWORK_DISCOVERY  1 = probe Docker networks, host addresses and host
#                         routes and pick the first free /24; 0 = deterministic
#                         hash of the project name, reads nothing (default).
#   PI_NETWORK_SUBNET     pin one exact /24 (single-instance / one-off only;
#                         global in .env would make every project collide).
# PI_NETWORK_BASE=10.200.0.0/13
# PI_NETWORK_DISCOVERY=1
# PI_NETWORK_SUBNET=10.200.7.0/24

# Outbound egress control (default ON — SECURITY.md B5).
# The agent runs on an internal Docker network whose only route to the internet
# is a sidecar proxy (src/egress-proxy.js, docker-compose.egress.yml).
#
#   EGRESS unset / true   allowlist mode: only EGRESS_ALLOWLIST hosts
#   EGRESS=research       allowlist + ANY public host on 80/443, with an SSRF
#                         guard that still refuses loopback, private ranges,
#                         link-local/metadata IPs, *.internal and non-web ports.
#                         Use it for broad research or recent news.
#   EGRESS=false          no proxy, no filtering (legacy)
#
# EGRESS_ALLOWLIST is comma-separated host[:port]; port defaults to 443 and
# *.host matches subdomains. Model calls ride HTTPS_PROXY; SSH git is tunnelled
# through the same proxy (netcat CONNECT), so github.com:22 must stay listed.
#
# Defaults cover model providers, git, npm/PyPI/crates and common search APIs.
# When a fetch is refused the proxy logs `DENY <host>:<port> (<reason>)` to
# stderr — add that host here, or switch to EGRESS=research.
#
#   EGRESS=research
#   EGRESS_ALLOWLIST=api.deepseek.com,github.com,github.com:22,registry.npmjs.org
